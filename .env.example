# GEMINI_API_KEY: Required for Gemini AI API calls.
# Get a key from Google AI Studio and keep the real value only in .env.local.
GEMINI_API_KEY=""

# Optional model for the grounded analytics Copilot. It has a local fallback.
AQUAMIND_COPILOT_MODEL="gemini-flash-lite-latest"
# Optional alternate if the primary is rate-limited.
AQUAMIND_RESEARCH_MODEL="gemini-3.5-flash-lite"

# Required for staging/production (≥32 random chars). Never commit real values.
# Development may omit this and use an in-process fallback (not for deploy).
JWT_SECRET_KEY="replace-with-a-long-random-secret"
PASSWORD_RESET_TOKEN="configure-a-rotating-admin-issued-token"
# Explicit connection string required in staging/production.
# Local development may use sqlite:///aquamind.db; production should use managed Postgres.
DATABASE_URL="sqlite:///aquamind.db"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Build-time frontend env. Set this to your deployed
# FastAPI origin (e.g. https://api.example.com) for any non-localhost build.
# Leave unset for local dev (falls back to http://127.0.0.1:8000) or when a
# reverse proxy forwards /api/* to FastAPI (falls back to same-origin /api).
VITE_API_BASE_URL=""

# ALLOWED_ORIGINS: Comma-separated browser origins for CORS (no paths, no '*').
# Required in staging/production when credentials are enabled, e.g.:
#   ALLOWED_ORIGINS=https://app.example.com,https://www.example.com
# Development defaults to localhost:3000 / 5173 / 8000 when unset.
ALLOWED_ORIGINS=""

# AQUAMIND_ENVIRONMENT: development | staging | production.
# Gates demo DB seeding, JWT secret enforcement, CORS, and SQLite fallback —
# set to "production" for any non-local deployment.
AQUAMIND_ENVIRONMENT="development"

# AQUAMIND_SEED_DEMO_DATA: false | true. Outside development, seeding is off
# unless this is explicitly true (demo accounts / sample telemetry).
AQUAMIND_SEED_DEMO_DATA="false"

# AQUAMIND_DEMO_MODE: false | true. Off unless set.
# When true, checked-in fixtures under fastapi_app/demo_fixtures/ may stand in
# for an optional provider that is unreachable (Gemini, Qwen, CLIPSeg, or the
# whole fusion), so a live demo survives a bad network. Fixture responses are
# always marked source="demo_fixture" and are never cached as real results.
# Leave false in production: with it off, an unavailable provider returns a
# clear error instead of substituted content.
AQUAMIND_DEMO_MODE="false"

# AQUAMIND_DEMO_FORCE_FIXTURES: false | true. Only honoured while demo mode is on.
# Skips the real provider entirely and serves the fixture immediately — use for
# a fully offline rehearsal, not for a normal demo.
AQUAMIND_DEMO_FORCE_FIXTURES="false"

# Max JSON body size for non-multipart requests (bytes). Default 2 MiB.
AQUAMIND_MAX_JSON_BYTES="2097152"

# Remote provider budgets (seconds). Defaults shown; raise only if a venue's
# network is slow but reliable. The recommendation budget caps the *total* time
# spent across all Gemini model attempts in one request, not each attempt.
AQUAMIND_REMOTE_AI_TIMEOUT_SEC="10"
AQUAMIND_REMOTE_AI_BUDGET_SEC="15"
# Vision budgets are much larger than the text ones: a full-resolution image
# through a hosted VLM routinely takes 20-35s.
AQUAMIND_VISION_TIMEOUT_SEC="45"
AQUAMIND_VISION_BUDGET_SEC="75"
# The CLIPSeg budget is generous because the first upload of a process also pays
# the one-time weight load. The overlay is optional either way — exceeding this
# returns the vision analysis without the segmentation layer.
AQUAMIND_CLIPSEG_TIMEOUT_SEC="60"
