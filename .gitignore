# =============================================================================
# AquaMind AI — .gitignore
# Keeps secrets, bulky datasets, caches, scratch artifacts, and local runtime
# junk out of git. Keep training_curves + *.metadata.json. Oversized .pkl
# models stay local. GitHub Actions CI is disabled (.github/ is ignored).
# =============================================================================

# --- Dependencies ---
node_modules/
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.egg

# --- Build / frontend output ---
build/
dist/
coverage/
*.tsbuildinfo
.next/
out/

# --- Env & secrets ---
.env
.env.*
!.env.example
!.env.local.example

# --- Logs & OS ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
Desktop.ini

# --- IDE / editor ---
.idea/
.vscode/
*.swp
*.swo
.cursor/

# --- Python tooling ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Local SQLite (seeded / synced at runtime) ---
aquamind.db
aquamind.db-*
*.sqlite
*.sqlite3

# --- Large Aqua datasets (local only; not for GitHub) ---
Aqua Dataset/
data/imports/
data/raw/
*.tif
*.tiff
*.csv.gz
*.parquet

# --- ML / vision local caches (AquaLens CLIPSeg etc.; do not commit) ---
.cache/
huggingface/
*.pt
*.pth
*.onnx
*.joblib
segmentation_data/
ai/reservoir_seg_model/

# --- Recommendation engine (Gemini response cache — token saver) ---
ai/.rec_cache/

# --- Climate Risk Open-Meteo response cache ---
climate/.om_cache/

# --- Trained model binaries (rebuild locally with: py ai/train.py) ---
# groundwater_model.pkl alone exceeds GitHub's 100MB limit.
ai/*.pkl

# --- AI / FastAPI runtime scratch (metadata + training_curves stay tracked) ---
ai/__pycache__/
ai/**/__pycache__/
fastapi_app/**/__pycache__/

# --- Uploads / temp / local debug scratch ---
# .tmp-* covers the endpoint-response dumps and probe scripts written by hand
# during debugging (.tmp-wsi.json, .tmp-scenarios.ps1, ...). Park anything you
# want to keep in _archive/ instead of leaving it loose in the repo root.
tmp/
temp/
uploads/
*.tmp
.tmp-*
.tmp_*/
*_tmp.json
*_tmp.ps1
.audit-*.log
.pytest_tmp*/

# --- Trained model artifacts (regenerated locally via the /train endpoints) ---
# Whole directory ignored: the .joblib weights are bulky and the .meta.json
# sidecars embed absolute machine paths (C:\Users\<you>\...). The canonical,
# reviewable model cards are ai/*.metadata.json, which stay tracked.
data/water_demand/artifacts/
data/reservoir/artifacts/

# --- Claude Code / Cursor local config ---
# Personal/machine-specific settings stay local.
.claude/
.claude/settings.local.json
.claude/*.local.json

# --- Hackathon binaries (markdown playbooks may be tracked; decks stay local) ---
hackathon/*.pptx
hackathon/*.ppt
hackathon/*.key

# --- Cleanup holding pen ---
# Scratch and duplicate files moved out of the repository root. Nothing in here
# is referenced by the app, build, tests, Docker or CI. See _archive/README.md;
# the whole folder is safe to delete.
_archive/

# --- GitHub Actions / workflows ---
# CI is intentionally not run on GitHub. Clone and run checks locally:
#   npm run lint && npm run build
#   py -m pytest fastapi_app/tests -q
# Ignoring .github/ keeps any local workflow experiments from being pushed.
.github/
