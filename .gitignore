# =============================================================================
# AquaMind AI — .gitignore
# Keeps secrets, bulky datasets, caches, and local runtime junk out of git.
# Keep training_curves + *.metadata.json. Oversized .pkl models stay local.
# =============================================================================

# --- Dependencies ---
node_modules/
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.egg

# --- Build / frontend output ---
build/
dist/
coverage/
*.tsbuildinfo
.next/
out/

# --- Env & secrets ---
.env
.env.*
!.env.example
!.env.local.example

# --- Logs & OS ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
Desktop.ini

# --- IDE / editor ---
.idea/
.vscode/
*.swp
*.swo
.cursor/

# --- Python tooling ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Local SQLite (seeded / synced at runtime) ---
aquamind.db
aquamind.db-*
*.sqlite
*.sqlite3

# --- Large Aqua datasets (local only; not for GitHub) ---
Aqua Dataset/
data/imports/
data/raw/
*.tif
*.tiff
*.csv.gz
*.parquet

# --- ML / vision local caches (AquaLens CLIPSeg etc.; do not commit) ---
.cache/
huggingface/
*.pt
*.pth
*.onnx
*.joblib
segmentation_data/
ai/reservoir_seg_model/

# --- Recommendation engine (Gemini response cache — token saver) ---
ai/.rec_cache/

# --- Climate Risk Open-Meteo response cache ---
climate/.om_cache/

# --- Trained model binaries (rebuild locally with: py ai/train.py) ---
# groundwater_model.pkl alone is ~2GB and exceeds GitHub's 100MB limit.
ai/*.pkl

# --- AI / FastAPI runtime scratch (metadata + training_curves stay tracked) ---
ai/__pycache__/
ai/**/__pycache__/
fastapi_app/**/__pycache__/

# --- Uploads / temp ---
tmp/
temp/
uploads/
*.tmp

# --- Trained model artifacts (regenerated locally via the /train endpoints) ---
# Whole directory ignored: the .joblib weights are bulky and the .meta.json
# sidecars embed absolute machine paths (C:\Users\<you>\...). The canonical,
# reviewable model cards are ai/*.metadata.json, which stay tracked.
data/water_demand/artifacts/
data/reservoir/artifacts/

# --- Claude Code local config ---
# Personal/machine-specific settings stay local; shared config (launch.json,
# settings.json) is committed so the team gets the same dev-server setup.
.claude/
.claude/settings.local.json
.claude/*.local.json

# --- GitHub local config / metadata ---
.github/
