{
  "model_type": "ExtraTreesClassifier",
  "task": "binary acoustic leak / no-leak detection",
  "source": "Aqua Dataset/Leak detection training data",
  "sensors": [
    "Accelerometer"
  ],
  "topologies": [
    "Branched",
    "Looped"
  ],
  "leak_types": [
    "Gasket Leak",
    "Orifice Leak",
    "Circumferential Crack",
    "Longitudinal Crack"
  ],
  "features": [
    "signal_mean",
    "signal_std",
    "signal_rms",
    "signal_min",
    "signal_max",
    "signal_peak_to_peak",
    "signal_skewness",
    "signal_kurtosis",
    "zero_crossing_rate",
    "crest_factor",
    "spectral_energy",
    "spectral_peak_freq",
    "spectral_centroid",
    "spectral_low_energy",
    "spectral_mid_energy",
    "spectral_high_energy"
  ],
  "target": "label (0=No-leak, 1=Leak)",
  "decision_threshold": 0.3,
  "split_method": "stratified file-level split + no-leak noise augmentation",
  "split_seed": 42,
  "metrics": {
    "validation": {
      "precision": 0.8696,
      "recall": 1.0,
      "f1": 0.9302,
      "accuracy": 0.875,
      "confusion_matrix": [
        [
          4,
          12
        ],
        [
          0,
          80
        ]
      ],
      "rows": 96
    },
    "test": {
      "precision": 0.7582,
      "recall": 0.9583,
      "f1": 0.8466,
      "accuracy": 0.7396,
      "confusion_matrix": [
        [
          2,
          22
        ],
        [
          3,
          69
        ]
      ],
      "rows": 96
    }
  },
  "limitations": [
    "Trained on accelerometer lab recordings (branched and looped topologies).",
    "No water-loss volume in training labels; volumetric estimates are not supported."
  ]
}